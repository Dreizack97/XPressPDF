<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppUI.Avalonia.ViewModels"
             x:Class="AppUI.Avalonia.Views.EmailSettingsView"
             x:DataType="vm:EmailSettingsViewModel">

    <StackPanel Spacing="10" Margin="15">
        <TextBlock Text="Correo electrónico" />
        <TextBox Text="{Binding Address}" Watermark="usuario@ejemplo.com" />

        <TextBlock Text="Contraseña" />
        <TextBox Text="{Binding Password}" PasswordChar="•" />

        <TextBlock Text="Nombre para mostrar" />
        <TextBox Text="{Binding DisplayName}" />

        <TextBlock Text="Servidor SMTP" />
        <TextBox Text="{Binding Host}" Watermark="smtp.ejemplo.com" />

        <TextBlock Text="Puerto" />
        <TextBox Text="{Binding Port}" Watermark="587" />

        <CheckBox Content="Usar SSL/TLS" IsChecked="{Binding Ssl}" />

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="Guardar" Classes="accent" Command="{Binding SaveCommand}" />
            <Button Content="Probar conexión" Command="{Binding TestConnectionCommand}" />
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding ResultMessage}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ResultMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Classes.error="{Binding ResultIsError}">
            <TextBlock.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="#34C759" />
                </Style>
                <Style Selector="TextBlock.error">
                    <Setter Property="Foreground" Value="#FF3B30" />
                </Style>
            </TextBlock.Styles>
        </TextBlock>
    </StackPanel>
</UserControl>
