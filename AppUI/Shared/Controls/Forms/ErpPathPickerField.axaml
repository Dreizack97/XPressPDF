<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:AppUI.Shared.Controls.Forms"
             xmlns:actions="using:AppUI.Shared.Controls.Actions"
             xmlns:display="using:AppUI.Shared.Controls.Display"
             x:Class="AppUI.Shared.Controls.Forms.ErpPathPickerField"
             x:Name="Root">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        <!-- Campo de texto de ruta -->
        <TextBox Grid.Column="0"
                 Height="{StaticResource ControlHeightMd}"
                 Text="{Binding SelectedPath, ElementName=Root, Mode=TwoWay}"
                 PlaceholderText="{Binding PlaceholderText, ElementName=Root}"
                 FontFamily="{StaticResource FiraCodeFontFamily}"
                 FontSize="{StaticResource FontSize300}"
                 CornerRadius="{StaticResource FieldRadius}"
                 Background="{DynamicResource SurfaceFieldBrush}"
                 BorderBrush="{DynamicResource LineDefaultBrush}"
                 VerticalContentAlignment="Center" />

        <!-- Botón Examinar -->
        <actions:ErpButton Grid.Column="1"
                           Variant="Secondary"
                           Size="Md"
                           LeadingIcon="FolderOpen"
                           Content="{Binding ButtonText, ElementName=Root}"
                           Command="{Binding BrowseCommand, ElementName=Root}" />
    </Grid>
</UserControl>
