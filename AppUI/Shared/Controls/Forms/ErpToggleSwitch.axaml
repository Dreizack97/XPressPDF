<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:forms="using:AppUI.Shared.Controls.Forms"
             x:Class="AppUI.Shared.Controls.Forms.ErpToggleSwitch"
             x:Name="Root">

    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <!-- Textos a la izquierda -->
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       Classes="text-body ink-strong"
                       FontWeight="Medium"
                       IsVisible="{Binding Label, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       Classes="text-caption ink-secondary"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Description, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- ToggleSwitch nativo estilizado a la derecha -->
        <ToggleSwitch Grid.Column="1"
                      IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                      OnContent=""
                      OffContent=""
                      VerticalAlignment="Center" />
    </Grid>
</UserControl>
