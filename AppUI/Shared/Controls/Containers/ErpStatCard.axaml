<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:containers="using:AppUI.Shared.Controls.Containers"
                    xmlns:display="using:AppUI.Shared.Controls.Display"
                    xmlns:converters="using:AppUI.Shared.Converters">

    <converters:ToneToBrushConverter x:Key="ToneSoftBrushConverter" Variant="SurfaceSoft" />
    <converters:ToneToBrushConverter x:Key="ToneInkBrushConverter" Variant="Ink" />

    <ControlTheme x:Key="{x:Type containers:ErpStatCard}" TargetType="containers:ErpStatCard">
        <Setter Property="Template">
            <ControlTemplate TargetType="containers:ErpStatCard">
                <Border Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource LineDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardRadius}"
                        Padding="{StaticResource CardPadding}"
                        BoxShadow="{StaticResource ElevationShadowSm}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <!-- 1. Etiqueta superior (Overline tracking amplio) -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{TemplateBinding Label}"
                                   Classes="text-overline"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        <!-- Icono en contenedor circular con tono semántico -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                Width="44" Height="44"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneSoftBrushConverter}}"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right">
                            <display:ErpIcon Kind="{TemplateBinding IconKind}"
                                           Size="22"
                                           Foreground="{Binding Tone, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToneInkBrushConverter}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                        </Border>

                        <!-- 2. Cifra KPI en Fira Code -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{TemplateBinding Value}"
                                   Classes="font-mono text-display"
                                   Margin="0,8,0,4"
                                   VerticalAlignment="Center" />

                        <!-- 3. Descripción secundaria opcional -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{TemplateBinding Description}"
                                   Classes="text-caption ink-secondary"
                                   IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
