<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================================================================
         NIVEL 3: TOKENS DE COMPONENTE (ComponentTokens.axaml)
         Paridad con Smart-Enterprise-ERP-Design-System (src/styles/tokens/component.css)
         ======================================================================= -->

    <!-- ==========================================
         1. ALTURAS DE CONTROL UNIFICADAS
         ========================================== -->
    <x:Double x:Key="ControlHeightSm">32</x:Double>
    <x:Double x:Key="ControlHeightMd">40</x:Double>
    <x:Double x:Key="ControlHeightLg">48</x:Double>

    <!-- ==========================================
         2. BOTÓN
         ========================================== -->
    <CornerRadius x:Key="ButtonRadius">12</CornerRadius>
    <Thickness x:Key="ButtonPaddingSm">12,0</Thickness>
    <Thickness x:Key="ButtonPaddingMd">16,0</Thickness>
    <Thickness x:Key="ButtonPaddingLg">24,0</Thickness>
    <x:Double x:Key="ButtonDisabledOpacity">0.5</x:Double>

    <!-- ==========================================
         3. CAMPOS DE ENTRADA (FIELD / INPUT)
         ========================================== -->
    <CornerRadius x:Key="FieldRadius">12</CornerRadius>
    <Thickness x:Key="FieldPadding">14,8</Thickness>
    <Thickness x:Key="FieldPaddingSm">10,6</Thickness>
    <x:Double x:Key="FieldDisabledOpacity">0.6</x:Double>

    <!-- ==========================================
         4. TARJETAS (SECTION CARD & STAT CARD)
         ========================================== -->
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="CardHeaderPadding">24,20</Thickness>

    <!-- ==========================================
         5. INSIGNIAS (BADGE & STATUS BADGE)
         ========================================== -->
    <CornerRadius x:Key="BadgeRadius">9999</CornerRadius>
    <Thickness x:Key="BadgePaddingSm">8,2</Thickness>
    <Thickness x:Key="BadgePaddingMd">10,4</Thickness>

    <!-- ==========================================
         6. ESTRUCTURA Y OVERLAYS (SHELL)
         ========================================== -->
    <x:Double x:Key="NavbarHeight">64</x:Double>
    <x:Double x:Key="SidebarWidth">256</x:Double>
    <x:Double x:Key="SidebarWidthCollapsed">80</x:Double>
    <x:Double x:Key="DrawerWidth">440</x:Double>
    <x:Double x:Key="ModalMaxWidth">520</x:Double>

</ResourceDictionary>
