<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="using:AppUI.Layout"
        xmlns:navbar="using:AppUI.Layout.Navbar"
        xmlns:sidebar="using:AppUI.Layout.Sidebar"
        xmlns:feedback="using:AppUI.Shared.Controls.Feedback"
        xmlns:conversionVm="using:AppUI.Features.Conversion.ViewModels"
        xmlns:conversionViews="using:AppUI.Features.Conversion.Views"
        xmlns:settingsVm="using:AppUI.Features.Settings.ViewModels"
        xmlns:settingsViews="using:AppUI.Features.Settings.Views"
        xmlns:diagVm="using:AppUI.Features.Diagnostics.ViewModels"
        xmlns:diagViews="using:AppUI.Features.Diagnostics.Views"
        x:Class="AppUI.Views.MainWindow"
        x:DataType="layout:MainWindowViewModel"
        Title="XPressPDF - Conversor Masivo de CFDI 4.0 a PDF"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceCanvasBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="conversionVm:ConversionWorkspaceViewModel">
            <conversionViews:ConversionWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="settingsVm:SettingsViewModel">
            <settingsViews:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="diagVm:DiagnosticsViewModel">
            <diagViews:DiagnosticsView />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel LastChildFill="True">
        <!-- 1. Barra de Navegación Superior -->
        <navbar:ErpNavbar x:Name="NavbarControl" DockPanel.Dock="Top" />

        <!-- 2. Barra Lateral Izquierda (Sidebar) -->
        <sidebar:ErpSidebar x:Name="SidebarControl" DockPanel.Dock="Left" />

        <!-- 3. Contenedor de la Vista Activa + Host de Notificaciones Flotantes -->
        <Grid>
            <!-- Vista Activa con transición suave -->
            <TransitioningContentControl Content="{Binding CurrentView}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="{StaticResource DurationInstant}" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <!-- Notificaciones Flotantes (Toast Host) -->
            <feedback:ErpToastHost x:Name="ToastHostControl"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" />
        </Grid>
    </DockPanel>
</Window>
