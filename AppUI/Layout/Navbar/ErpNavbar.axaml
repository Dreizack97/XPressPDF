<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:navbar="using:AppUI.Layout.Navbar"
             xmlns:actions="using:AppUI.Shared.Controls.Actions"
             xmlns:feedback="using:AppUI.Shared.Controls.Feedback"
             xmlns:display="using:AppUI.Shared.Controls.Display"
             x:Class="AppUI.Layout.Navbar.ErpNavbar"
             x:Name="Root"
             Height="{StaticResource NavbarHeight}">

    <Border Background="{DynamicResource Surface1Brush}"
            BorderBrush="{DynamicResource LineDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,0">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- 1. Marca de la Aplicación -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Icono de Marca XPressPDF -->
                <Border Width="36" Height="36"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="#2563EB">
                    <display:ErpIcon Kind="Zap"
                                   Size="20"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <!-- Título y Versión -->
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="XPressPDF"
                                   FontFamily="{StaticResource FiraSansFontFamily}"
                                   FontSize="{StaticResource FontSize400}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource InkStrongBrush}" />
                        <feedback:ErpBadge Text="CFDI 4.0"
                                           Tone="Blue"
                                           Size="Sm" />
                    </StackPanel>
                    <TextBlock Text="Conversor Masivo de XML a PDF"
                               Classes="text-caption ink-muted" />
                </StackPanel>
            </StackPanel>

            <!-- 2. Centro: Indicador de Motor -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <feedback:ErpStatusBadge Status="Success"
                                         Text="Motor .NET 10 Activo"
                                         Size="Sm" />
            </StackPanel>

            <!-- 3. Acciones a la Derecha (Selector de Tema) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <actions:ErpThemeToggle x:Name="ThemeToggleControl" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
